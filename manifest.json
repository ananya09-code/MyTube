{
  "manifest_version": 3,
  "name": "mytube",
  "version": "1.0.0",
  "description": "Collect video links into topic lists and download each list with yt-dlp into a folder per topic.",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "clipboardRead",
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "mytube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "add-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Add the current tab URL to the active list"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
